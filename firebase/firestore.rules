rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMemberOf(spaceId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds;
    }

    function isCreator(spaceId) {
      return isSignedIn()
        && request.auth.uid == get(/databases/$(database)/documents/spaces/$(spaceId)).data.createdBy;
    }

    // 邀請碼 → 帳本 ID（加入者用此查詢，已登入即可讀）
    match /invites/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['spaceId'])
        && get(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read, create: if isSignedIn() && request.auth.uid == userId;
      // 本人可改；建立者可將被移除成員的 spaceId 清為 null
      allow update: if isSignedIn() && (
        request.auth.uid == userId
        || (
          resource.data.spaceId != null
          && request.resource.data.spaceId == null
          && isCreator(resource.data.spaceId)
        )
      );
    }

    match /spaces/{spaceId} {
      // 成員可讀；尚有空位（1人）的帳本也可讀（加入前預覽）
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds
        || resource.data.memberIds.size() < 2
      );
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 1;
      // 成員可改；新成員加入；建立者可移除另一位成員（2→1）
      allow update: if isSignedIn() && (
        isMemberOf(spaceId)
        || (
          resource.data.memberIds.size() < 2
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() <= 2
        )
        || (
          isCreator(spaceId)
          && resource.data.memberIds.size() == 2
          && request.resource.data.memberIds.size() == 1
          && request.auth.uid in request.resource.data.memberIds
        )
      );
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn() && isMemberOf(resource.data.spaceId);
      allow create: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.memberIds
        && request.resource.data.isSystem == true;
      allow update, delete: if false;
    }

    match /expenses/{expenseId} {
      allow read, update, delete: if isSignedIn() && isMemberOf(resource.data.spaceId);
      allow create: if isSignedIn()
        && isMemberOf(request.resource.data.spaceId)
        && request.resource.data.createdBy == request.auth.uid;
    }
  }
}
